{
    "name": "abelohost/test_blog",
    "description": "MVC blog on PHP + Smarty",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^4.5",
        "webmozart/assert": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"if (!is_dir('var/smarty/cache')) { mkdir('var/smarty/cache', 0777, true); } chmod('var/smarty/cache', 0777);\"",
            "@php -r \"if (!is_dir('var/smarty/compile')) { mkdir('var/smarty/compile', 0777, true); } chmod('var/smarty/compile', 0777);\""
        ],
        "post-update-cmd": [
            "@php -r \"if (!is_dir('var/smarty/cache')) { mkdir('var/smarty/cache', 0777, true); } chmod('var/smarty/cache', 0777);\"",
            "@php -r \"if (!is_dir('var/smarty/compile')) { mkdir('var/smarty/compile', 0777, true); } chmod('var/smarty/compile', 0777);\""
        ]
    }
}
